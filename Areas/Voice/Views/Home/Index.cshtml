@{
    ViewData["Title"] = "Voice";
}

<div class="card flex-fill shadow-sm border-0 d-flex flex-column">
    <div class="card-header bg-success text-white">
        <div class="fw-bold">Whisper</div>
    </div>

    <div class="card-body d-flex flex-column gap-2">
        <textarea class="form-control flex-fill" id="memo" rows="8"></textarea>
        <div class="p-3 border rounded bg-light d-flex gap-2">
            <button class="btn btn-primary" style="min-width: 80px;"
                    type="button" onclick="startVoice()">
                Start
            </button>
            <button class="btn btn-danger" style="min-width: 80px;"
                    type="button" onclick="stopVoice()">
                Stop
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let socket, audioContext, source, workletNode, stream;

        async function startVoice() {
            const protocol = location.protocol === "https:" ? "wss://" : "ws://";
            socket = new WebSocket(protocol + location.host + "/ws/voice");
            socket.binaryType = "arraybuffer";

            socket.onmessage = event => {
                const result = JSON.parse(event.data);
                if (result.text) document.getElementById("memo").value = result.text;
            };

            socket.onopen = async () => {
                stream = await navigator.mediaDevices.getUserMedia({
                    audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true }
                });

                audioContext = new AudioContext();
                await audioContext.audioWorklet.addModule("/js/pcm-worklet.js");

                source = audioContext.createMediaStreamSource(stream);
                workletNode = new AudioWorkletNode(audioContext, "pcm-worklet-processor");

                workletNode.port.onmessage = event => {
                    if (socket.readyState === WebSocket.OPEN) socket.send(event.data);
                };

                source.connect(workletNode);
                workletNode.connect(audioContext.destination);
            };
        }

        function stopVoice() {
            if (workletNode) workletNode.disconnect();
            if (source) source.disconnect();
            if (audioContext) audioContext.close();
            if (stream) stream.getTracks().forEach(track => track.stop());
            if (socket?.readyState === WebSocket.OPEN) socket.close();
        }
    </script>
}
